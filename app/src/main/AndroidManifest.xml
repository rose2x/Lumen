<?xml version="1.0" encoding="utf-8"?>
<!--
    AndroidManifest.xml
    This is the "ID card" of the app: it tells Android what permissions
    we need, what screens (Activities) and background services exist,
    and basic app metadata.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Needed to download the Alpine rootfs on first launch -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Keeps the shell session alive while the app is backgrounded -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <!-- Lets the shell read/write your phone's normal files (photos,
         downloads, etc.) via ~/storage symlinks, the same mechanism
         Termux's own termux-setup-storage command uses. -->
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE"
        tools:ignore="ScopedStorage" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="29" />

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:theme="@style/Theme.Vironix"
        android:supportsRtl="true"
        android:usesCleartextTraffic="false">

        <!-- App entry point: pick a distro (and see root/no-root status) first. -->
        <activity
            android:name=".DistroPickerActivity"
            android:exported="true"
            android:theme="@style/Theme.Vironix">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".TerminalActivity"
            android:exported="false"
            android:configChanges="orientation|screenSize|keyboardHidden"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".SettingsActivity"
            android:exported="false"
            android:label="Settings" />

        <!-- Keeps the proot session running even if the screen is off
             or the user switches apps, same approach Termux uses. -->
        <service
            android:name=".TerminalService"
            android:exported="false"
            android:foregroundServiceType="specialUse" />

    </application>
</manifest>

<?xml version="1.0" encoding="utf-8"?>
<!--
    activity_distro_picker.xml
    First screen the user sees: choose which Linux distro to install/open,
    and see whether Vironix detected root access on this device.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#0D0D0D"
    android:padding="20dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Vironix"
            android:textColor="#00FF41"
            android:textSize="28sp"
            android:fontFamily="monospace"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/settingsButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="\u2699 Settings"
            android:textColor="#888888"
            android:textSize="14sp"
            android:fontFamily="monospace"
            android:padding="8dp"
            android:clickable="true"
            android:focusable="true" />

    </LinearLayout>

    <TextView
        android:id="@+id/rootStatusText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="Checking root access..."
        android:textColor="#888888"
        android:textSize="13sp"
        android:fontFamily="monospace" />

    <TextView
        android:id="@+id/storageStatusText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="Storage access: not granted — tap to enable"
        android:textColor="#888888"
        android:textSize="13sp"
        android:fontFamily="monospace"
        android:clickable="true"
        android:focusable="true" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:text="Choose a distribution:"
        android:textColor="#FFFFFF"
        android:textSize="16sp"
        android:fontFamily="monospace" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/distroList"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="12dp"
        android:clipToPadding="false" />

</LinearLayout>

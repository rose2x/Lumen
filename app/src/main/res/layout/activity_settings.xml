<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0D0D0D">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Settings"
            android:textColor="#00FF41"
            android:textSize="24sp"
            android:fontFamily="monospace"
            android:textStyle="bold" />

        <!-- Font size -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:text="Font size"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:fontFamily="monospace" />

        <TextView
            android:id="@+id/fontSizeValue"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="14sp"
            android:textColor="#888888"
            android:textSize="13sp"
            android:fontFamily="monospace" />

        <SeekBar
            android:id="@+id/fontSizeSeekBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="20"
            android:progressTint="#00FF41"
            android:thumbTint="#00FF41" />

        <!-- Cursor style -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="Cursor style"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:fontFamily="monospace" />

        <RadioGroup
            android:id="@+id/cursorStyleGroup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="8dp">

            <RadioButton
                android:id="@+id/cursorBlock"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Block"
                android:textColor="#FFFFFF"
                android:fontFamily="monospace" />

            <RadioButton
                android:id="@+id/cursorUnderline"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="20dp"
                android:text="Underline"
                android:textColor="#FFFFFF"
                android:fontFamily="monospace" />

            <RadioButton
                android:id="@+id/cursorBar"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="20dp"
                android:text="Bar"
                android:textColor="#FFFFFF"
                android:fontFamily="monospace" />

        </RadioGroup>

        <!-- Terminal bell -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Terminal bell"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:fontFamily="monospace" />

            <Switch
                android:id="@+id/bellSwitch"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />

        </LinearLayout>

        <!-- Color scheme -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="Color scheme"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:fontFamily="monospace" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/colorSchemeList"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:nestedScrollingEnabled="false" />

    </LinearLayout>

</ScrollView>
